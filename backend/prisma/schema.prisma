generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  provider        String        @default("email")
  role            String        @default("player")
  isBanned        Boolean       @default(false)
  lastLoginAt     DateTime?
  loginStreak     Int           @default(0)
  dailyClaimDay   Int           @default(0)
  lastDailyClaim  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  character       Character?
  farm            Farm?
  inventory       InventoryItem[]
  quests          UserQuest[]
  loginLogs       LoginLog[]
  friendships     Friendship[]  @relation("UserFriends")
  friendOf        Friendship[]  @relation("FriendOf")

  @@index([email])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  isMorning Boolean  @default(false)
  ip        String?
  synced    Boolean  @default(false)

  @@index([userId, loginAt])
  @@index([isMorning, loginAt])
}

model Character {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  gender     String   @default("male")
  hairStyle  Int      @default(0)
  hairColor  String   @default("#4A3728")
  eyeColor   String   @default("#2E5A1C")
  skinTone   String   @default("#F5D0C5")
  level      Int      @default(1)
  experience Int      @default(0)
  energy     Int      @default(100)
  maxEnergy  Int      @default(100)
  posX       Float    @default(400)
  posY       Float    @default(450)
  currentMap String   @default("farm")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Farm {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String       @default("My Farm")
  level       Int          @default(1)
  size        Int          @default(1)
  weather     String       @default("sunny")
  timeOfDay   String       @default("morning")
  plots       FarmPlot[]
  animals     Animal[]
  decorations Decoration[]
  lastSavedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model FarmPlot {
  id          String    @id @default(cuid())
  farmId      String
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  x           Int
  y           Int
  state       String    @default("empty")
  cropType    String?
  plantedAt   DateTime?
  wateredAt   DateTime?
  growthStage Int       @default(0)
  quality     String    @default("common")
  fertilized  Boolean   @default(false)

  @@unique([farmId, x, y])
  @@index([farmId])
}

model Animal {
  id              String    @id @default(cuid())
  farmId          String
  farm            Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  type            String
  name            String?
  happiness       Int       @default(80)
  hunger          Int       @default(50)
  posX            Float     @default(200)
  posY            Float     @default(520)
  productReady    Boolean   @default(true)
  lastCollectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([farmId])
}

model Decoration {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  itemId String
  x      Float
  y      Float
  rot    Int    @default(0)

  @@index([farmId])
}

model InventoryItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  quantity Int    @default(1)

  @@unique([userId, itemId])
  @@index([userId])
}

model Quest {
  id            String  @id @default(cuid())
  code          String  @unique
  type          String
  titleTh       String
  titleEn       String
  descriptionTh String
  descriptionEn String
  requirements  Json
  rewards       Json
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id])
  progress    Json      @default("{}")
  status      String    @default("active")
  completedAt DateTime?
  claimedAt   DateTime?

  @@unique([userId, questId])
  @@index([userId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}
